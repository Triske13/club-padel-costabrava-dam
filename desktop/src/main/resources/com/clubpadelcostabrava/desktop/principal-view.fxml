<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import java.net.URL?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.clubpadelcostabrava.desktop.ui.PrincipalController"
            prefWidth="900" prefHeight="600">
    <top>
        <VBox>
            <HBox spacing="8" style="-fx-padding: 12;">
                <Button text="Agenda" onAction="#onAgenda"/>
                <Button text="Reservas" onAction="#onReservas"/>
                <Button text="Socios" onAction="#onSocios"/>
                <Button text="Mi cuenta" onAction="#onMiCuenta"/>
                <Button fx:id="salirButton" text="Salir" onAction="#onSalir"/>
            </HBox>
            <Region prefHeight="120" minHeight="120" maxHeight="120"
                    styleClass="club-banner">
                <clip>
                    <Rectangle x="16" y="0" width="300" height="120"
                               arcWidth="20" arcHeight="20"/>
                </clip>
            </Region>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="contenidoPane"/>
    </center>
    <stylesheets>
        <URL value="@banner.css"/>
    </stylesheets>
</BorderPane>