<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.clubpadelcostabrava.desktop.ui.CodigoController"
      alignment="CENTER" spacing="10"
      prefWidth="460" prefHeight="400"
      style="-fx-padding: 20;">
    <Label text="Recuperar acceso"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <TextField fx:id="correoField" promptText="Correo"/>
    <Button fx:id="solicitarButton"
            text="Solicitar código"
            onAction="#onSolicitarCodigo"/>
    <TextField fx:id="codigoField" promptText="Código de 6 cifras"/>
    <PasswordField fx:id="nuevaField" promptText="Nueva contraseña"/>
    <Button fx:id="guardarButton"
            text="Guardar contraseña"
            onAction="#onGuardarContrasena"/>
    <Button text="Volver al acceso" onAction="#onVolver"/>
    <Label fx:id="mensajeLabel" wrapText="true"/>
</VBox>