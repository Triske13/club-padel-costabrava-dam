<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.clubpadelcostabrava.desktop.ui.AgendaController"
      spacing="12" prefWidth="780" prefHeight="520"
      style="-fx-padding: 20;">
    <Label text="Agenda"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="8">
        <DatePicker fx:id="fechaPicker"/>
        <Button text="Consultar" onAction="#onConsultar"/>
    </HBox>

    <Label fx:id="mensajeLabel"/>
    <TabPane fx:id="pistasTabPane" VBox.vgrow="ALWAYS"/>
</VBox>